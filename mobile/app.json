{
  "expo": {
    "name": "Daybook",
    "slug": "daybook",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.jessicaeaton.daybook",
      "adaptiveIcon": {
        "backgroundColor": "#EFEBE1",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "DaybookToday",
              "label": "Daybook: Today",
              "description": "Today's habits with one-tap logging",
              "minWidth": "180dp",
              "minHeight": "140dp",
              "targetCellWidth": 3,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable|configuration_optional"
            },
            {
              "name": "DaybookHabit",
              "label": "Daybook: Single habit",
              "description": "One habit with one-tap logging",
              "minWidth": "110dp",
              "minHeight": "50dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000,
              "widgetFeatures": "reconfigurable"
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "c263a67a-386a-4811-bea0-4fdd6126bf30"
      }
    }
  }
}
